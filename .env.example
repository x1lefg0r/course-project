# Django
SECRET_KEY=your-very-secret-key-here
DEBUG=0
ALLOWED_HOSTS=yourdomain.com www.yourdomain.com

# Database (PostgreSQL)
POSTGRES_DB=electronics
POSTGRES_USER=django
POSTGRES_PASSWORD=your-db-password
DATABASE_URL=postgres://django:your-db-password@postgres:5432/electronics

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Email (production SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Sentry
SENTRY_DSN=https://your-dsn@sentry.io/your-project
ENVIRONMENT=production

# Google OAuth2
# Получить на: https://console.cloud.google.com → Credentials → OAuth 2.0
# Добавить в Authorized redirect URIs: http://yourdomain.com/auth/complete/google-oauth2/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
